import os
from pdf2docx import Converter

def convertir_pdf_a_word(archivo_pdf, archivo_word=None):
    """
    Convierte un archivo PDF a formato Word (DOCX)
    
    Args:
        archivo_pdf (str): Ruta del archivo PDF de entrada
        archivo_word (str, opcional): Ruta del archivo Word de salida. 
                                     Si no se proporciona, se usará el mismo nombre que el PDF.
    
    Returns:
        str: Ruta del archivo Word generado
    """
    # Verificar que el archivo PDF exista
    if not os.path.exists(archivo_pdf):
        print(f"Error: El archivo '{archivo_pdf}' no existe.")
        return None
    
    # Si no se proporciona un nombre para el archivo Word, usar el mismo nombre que el PDF
    if archivo_word is None:
        archivo_word = os.path.splitext(archivo_pdf)[0] + '.docx'
    
    try:
        # Crear el convertidor
        cv = Converter(archivo_pdf)
        # Realizar la conversión
        cv.convert(archivo_word)
        # Cerrar el convertidor
        cv.close()
        
        print(f"Conversión exitosa: '{archivo_pdf}' -> '{archivo_word}'")
        return archivo_word
    
    except Exception as e:
        print(f"Error durante la conversión: {e}")
        return None

